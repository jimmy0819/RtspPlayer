<UserControl x:Class="RtspPlayer.GstreamerPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RtspPlayer"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Image x:Name="videoImage" Stretch="Uniform" />
        <WrapPanel Margin="10" x:Name="TagShow">
            <Border Background="LightBlue" CornerRadius="5" Padding="4" Margin="2">
                <TextBlock Text="UnDef"  x:Name="TagWord" Foreground="Black"/>
            </Border>
        </WrapPanel>
        
    </Grid>
</UserControl>
